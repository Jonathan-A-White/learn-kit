{
  "name": "learn-kit",
  "version": "0.1.6",
  "description": "The learning graph, levels, schedule, drills and learner profile shared by Lampas and Kestrel, as small framework-free libraries: @learn-kit/graph (nodes and needs, order, levels and a store, the frontier and the review schedule), @learn-kit/drill (the drill walk, forms, a sitting's mix and the placement) and @learn-kit/learner (the learner profile, a goal and its scaffolding).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonathan-A-White/learn-kit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    "./graph": {
      "types": "./packages/graph/dist/index.d.ts",
      "default": "./packages/graph/dist/index.js"
    },
    "./drill": {
      "types": "./packages/drill/dist/index.d.ts",
      "default": "./packages/drill/dist/index.js"
    },
    "./learner": {
      "types": "./packages/learner/dist/index.d.ts",
      "default": "./packages/learner/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/*/dist/**",
    "packages/*/package.json",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b packages/graph/tsconfig.build.json packages/drill/tsconfig.build.json packages/learner/tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check:personal && vitest run",
    "check:personal": "node scripts/check-personal.mjs",
    "smoke": "bash scripts/consumer-smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.18"
  }
}
